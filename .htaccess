# nav Lyon bus — hébergement Apache mutualisé (Infomaniak). Aucun PHP, aucun npm requis.
# Rôle : refuser les robots, ne jamais exposer les fichiers de développement, ne pas être référencé.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # robots.txt reste lisible par tous (il interdit déjà tout)
  RewriteRule ^robots\.txt$ - [L]

  # Robots et outils automatiques : agent vide ou connu -> 403
  RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
  RewriteCond %{HTTP_USER_AGENT} (bot/|bot;|\+http|googlebot|bingbot|gptbot|claudebot|anthropic|ccbot|bytespider|petalbot|ahrefs|semrush|mj12|dotbot|yandex|baiduspider|duckduckbot|applebot|perplexity|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|crawl|spider|slurp|scrapy|headless|phantomjs|selenium|puppeteer|playwright|python|curl|wget|httpclient|okhttp|go-http|libwww|axios|node-fetch) [NC]
  RewriteRule ^ - [F,L]

  # Fichiers de développement : jamais accessibles
  RewriteRule ^(scripts|tests|node_modules|\.github|\.git)(/|$) - [F,L]
  RewriteRule ^(package(-lock)?\.json|README\.md|\.gitignore|\.gitattributes)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"

  # Le service worker et la page d'accueil doivent toujours être revérifiés
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
